---
// Hero visual: completion is measured (94%), the decisions themselves are not.
// Makes "attendance isn't adoption" legible at a glance.
---

<div class="card p-6 sm:p-7">
  <p class="font-mono text-[11px] uppercase tracking-wider text-ink-400">After the rollout</p>

  <div class="mt-5">
    <div class="flex items-baseline justify-between">
      <span class="text-sm text-ink-200">Everyone completed the training</span>
      <span class="font-display text-lg font-bold text-accent">94%</span>
    </div>
    <div class="mt-2 h-3 overflow-hidden rounded-full bg-ink-700">
      <div class="h-full rounded-full bg-accent" style="width: 94%"></div>
    </div>
    <p class="mt-1.5 font-mono text-[11px] uppercase tracking-wider text-ink-500">measured</p>
  </div>

  <div class="mt-6">
    <div class="flex items-baseline justify-between">
      <span class="text-sm text-ink-200">Decisions made as intended</span>
      <span class="font-display text-lg font-bold text-ink-500">?</span>
    </div>
    <div class="mt-2 h-3 rounded-full border border-dashed border-ink-600"></div>
    <p class="mt-1.5 font-mono text-[11px] uppercase tracking-wider text-ink-500">unmeasured</p>
  </div>
</div>
