---
// Sticky top navigation. On pages that open with the dark hero, `variant`
// is "overlay": the bar starts transparent over the hero and swaps to a
// solid white bar once the page is scrolled.
interface Props {
  base?: string; // prefix so links work from sub-routes (e.g. "/")
  variant?: 'solid' | 'overlay';
}
const { base = '', variant = 'solid' } = Astro.props;

import Logo from './Logo.astro';

const links = [
  { href: `${base}#capabilities`, label: 'Capabilities' },
  { href: `${base}#architecture`, label: 'Architecture' },
  { href: `${base}#process`, label: 'How it works' },
  { href: `${base}#pricing`, label: 'Pricing' },
  { href: '/about', label: 'About' },
];

const overlay = variant === 'overlay';
const shell = overlay
  ? 'nav-overlay sticky top-0 z-50 -mb-16 border-b transition-colors duration-300'
  : 'sticky top-0 z-50 border-b border-slate-200 bg-white/90 backdrop-blur-md';
const linkClass = overlay
  ? 'nav-link text-sm font-medium transition'
  : 'text-sm font-medium text-slate-600 transition hover:text-brand-600';
const ctaClass = overlay ? 'btn nav-cta !px-4 !py-2' : 'btn btn-primary !px-4 !py-2';
---

<header class={shell} data-nav={overlay ? 'overlay' : 'solid'}>
  <nav class="container-x flex h-16 items-center justify-between">
    <a href={base || '/'} class="transition hover:opacity-80" aria-label="XAD Labs home">
      {
        overlay && (
          <span class="logo-light">
            <Logo size="md" tone="light" />
          </span>
        )
      }
      <span class="logo-dark">
        <Logo size="md" />
      </span>
    </a>

    <div class="hidden items-center gap-7 lg:flex">
      {links.map((l) => <a href={l.href} class={linkClass}>{l.label}</a>)}
      <a href="https://podpdf.com" target="_blank" rel="noopener" class={linkClass}>PodPDF ↗</a>
      <a href={`${base}#corpus-report`} class={ctaClass}>Free corpus report</a>
    </div>

    <!-- Mobile: CTA plus a no-JS disclosure menu -->
    <div class="flex items-center gap-2 lg:hidden">
      <a href={`${base}#corpus-report`} class={`${ctaClass} text-xs`}>Free corpus report</a>

      <details class="nav-menu">
        <summary
          class={`flex h-9 w-9 cursor-pointer items-center justify-center rounded-md border border-current/30 ${overlay ? 'nav-link' : 'text-slate-600'}`}
          aria-label="Open menu"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-5 w-5">
            <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"></path>
          </svg>
        </summary>

        <ul
          class="absolute inset-x-0 top-16 z-50 space-y-1 border-y border-slate-200 bg-white px-6 py-4 shadow-lg"
        >
          {
            links.map((l) => (
              <li>
                <a href={l.href} class="block py-2 text-sm font-medium text-slate-700">
                  {l.label}
                </a>
              </li>
            ))
          }
          <li>
            <a
              href="https://podpdf.com"
              target="_blank"
              rel="noopener"
              class="block py-2 text-sm font-medium text-slate-700">PodPDF ↗</a
            >
          </li>
        </ul>
      </details>
    </div>
  </nav>
</header>

<script>
  // The overlay bar only takes on a solid background once it leaves the hero.
  const bar = document.querySelector<HTMLElement>('header[data-nav="overlay"]');
  if (bar) {
    const sync = () => bar.classList.toggle('is-stuck', window.scrollY > 24);
    sync();
    window.addEventListener('scroll', sync, { passive: true });
  }
</script>
