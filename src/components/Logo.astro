---
// Wordmark only — "xad labs" set in the UI face, so it always matches the
// loaded type. `tone` flips it for dark grounds.
interface Props {
  size?: 'sm' | 'md';
  tone?: 'dark' | 'light';
  class?: string;
}
const { size = 'md', tone = 'dark', class: className = '' } = Astro.props;
const textSize = size === 'sm' ? 'text-lg' : 'text-xl';
const first = tone === 'light' ? 'text-brand-200' : 'text-brand-600';
const second = tone === 'light' ? 'text-white' : 'text-slate-900';
---

<span
  class={`font-display font-semibold lowercase leading-none tracking-tight ${textSize} ${className}`}
  aria-hidden="true"
>
  <span class={first}>xad</span><span class={`ml-1.5 ${second}`}>labs</span>
</span>
