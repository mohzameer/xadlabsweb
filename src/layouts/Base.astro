---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'XAD Labs — PDF generation at scale',
  description =
    'XAD Labs builds and operates the document infrastructure behind high-volume PDF generation — from thousands of documents to several million. Makers of PodPDF. Colombo, Sri Lanka.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://xadlabs.com').href;

// Organization markup, so search engines read the company, its platform and
// its founder rather than inferring them from the page copy.
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'XAD Labs',
  url: 'https://xadlabs.com',
  description:
    'XAD Labs builds and operates the document infrastructure behind high-volume PDF generation, from thousands of documents to several million.',
  email: 'zameer@xadlabs.com',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Colombo',
    addressCountry: 'LK',
  },
  founder: {
    '@type': 'Person',
    name: 'Mohammed Zameer',
    sameAs: 'https://www.linkedin.com/in/zameermfm/',
  },
  sameAs: ['https://podpdf.com', 'https://www.linkedin.com/in/zameermfm/'],
  makesOffer: {
    '@type': 'Offer',
    itemOffered: {
      '@type': 'Service',
      name: 'High-volume PDF generation and document processing pipelines',
      serviceType: 'Document processing',
    },
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="XAD Labs" />
    <meta property="og:locale" content="en" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <meta name="theme-color" content="#FFFFFF" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&family=JetBrains+Mono:wght@400;500&display=swap"
    />

    <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
  </head>
  <body>
    <slot />
  </body>
</html>
