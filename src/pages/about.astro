---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';


const beliefs = [
  {
    icon: 'eye',
    title: 'Read the corpus first',
    body: 'Every estimate made before looking at the actual files is fiction. The corpus report exists because the archive always disagrees with the description of it.',
  },
  {
    icon: 'target',
    title: 'Build for the exceptions',
    body: 'The happy path is a weekend of work. The pipeline is defined by what it does with the encrypted, the corrupt, the mis-scanned and the one-off.',
  },
  {
    icon: 'ledger',
    title: 'Be answerable afterwards',
    body: 'A run that cannot tell you what happened to document 812,304 is not finished. Auditability is a design requirement, not a report you generate later.',
  },
];
---

<Base
  title="About — XAD Labs"
  description="XAD Labs is an independent engineering company in Colombo, Sri Lanka, building custom document processing pipelines and the PodPDF platform."
>
  <Nav base="/" variant="overlay" />

  <main>
    <!-- ================= INTRO ================= -->
    <section class="relative overflow-hidden pt-16 text-white">
      <div class="absolute inset-0 hero-ground"></div>

      <div class="container-x relative py-20 sm:py-28">
        <div class="max-w-3xl">
          <span
            class="inline-flex items-center gap-2 rounded-full border border-white/25 bg-white/10 px-3.5 py-1.5 font-mono text-[11px] tracking-wide text-brand-100"
          >
            <span class="h-1.5 w-1.5 rounded-full bg-brand-300"></span>
            Colombo, Sri Lanka
          </span>

          <h1
            class="mt-6 font-serif text-[2.5rem] font-normal leading-[1.08] sm:text-[3.25rem]"
          >
            An independent engineering company for documents at scale.
          </h1>

          <p class="mt-6 max-w-2xl text-lg leading-relaxed text-brand-100">
            XAD Labs builds the infrastructure that moves large volumes of documents — our own
            platform, PodPDF, and the custom pipelines we design and operate for organisations whose
            archives are too large, too messy, or too specific for anything off the shelf.
          </p>
        </div>

      </div>
    </section>

    <!-- ================= WHAT WE DO ================= -->
    <section class="border-b border-slate-200 bg-mist">
      <div class="container-x py-20 sm:py-24">
        <div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
          <div>
            <p class="eyebrow">What we work on</p>
            <h2 class="h2 mt-3">One problem, at two ends of the same scale</h2>
          </div>
          <div class="mt-1 space-y-5 text-lg leading-relaxed text-slate-600">
            <p>
              <a
                href="https://podpdf.com"
                target="_blank"
                rel="noopener"
                class="font-medium text-brand-600 underline decoration-brand-300 underline-offset-2 hover:decoration-brand-500"
                >PodPDF</a
              > is the self-serve end: a REST API and web app for generating, converting, merging and
              editing PDFs, used by developers and teams who want the problem handled by the document
              rather than by the project.
            </p>
            <p>
              The other end is this: managed pipelines for runs that start in the tens of thousands
              and go into the millions. Different engineering entirely — queueing, partial failure,
              cost per document, resumability, and an audit trail that holds up when someone asks
              about a single file six months later.
            </p>
            <p>
              Both come from the same place: the belief that document work is an infrastructure
              problem, and that most organisations are solving it with scripts that were never meant
              to carry this much.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= HOW WE WORK ================= -->
    <section class="border-b border-slate-200">
      <div class="container-x py-20 sm:py-24">
        <div class="max-w-2xl">
          <p class="eyebrow">How we work</p>
          <h2 class="h2 mt-3">Three things we hold to</h2>
        </div>

        <div class="mt-12 grid gap-6 lg:grid-cols-3">
          {
            beliefs.map((b, i) => (
              <div class="card p-7"={i * 90}>
                <span class="icon-tile">
                  <Icon name={b.icon} class="h-5 w-5" />
                </span>
                <h3 class="mt-5 font-display text-lg font-semibold text-slate-900">{b.title}</h3>
                <p class="mt-2.5 text-[15px] leading-relaxed text-slate-600">{b.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ================= BACKGROUND ================= -->
    <section class="border-b border-slate-200 bg-mist">
      <div class="container-x py-20 sm:py-24">
        <div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
          <div>
            <p class="eyebrow">Background</p>
            <h2 class="h2 mt-3">The experience the pipelines are built on</h2>
          </div>

          <div class="space-y-5 text-lg leading-relaxed text-slate-600">
            <p>
              The company's engineering comes out of years of product development, software
              architecture and scaling systems under real production load — including ongoing
              consulting work for a European startup, delivered through a Sri Lankan–Norwegian
              software partnership.
            </p>
            <p>
              That background is the point. Processing a few million documents reliably is not a
              document problem; it is a distributed systems problem wearing a document costume —
              queues, idempotency, backpressure, cost control and failure accounting. We stay
              deliberately small and take on work where that engineering is the difference.
            </p>
            <p>
              Everything we build, we also run. PodPDF is our own platform under the same load we
              design for, which is where most of what we know about PDFs at volume came from.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= CTA ================= -->
    <section class="border-b border-slate-200">
      <div class="container-x py-20 sm:py-24">
        <div
          class="flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-center"
        >
          <div>
            <h2 class="font-serif text-[1.75rem] leading-tight text-slate-900 sm:text-[2rem]">
              Have an archive that needs moving?
            </h2>
            <p class="mt-3 max-w-xl text-[15px] leading-relaxed text-slate-600">
              Start with a free corpus report — we will tell you what is in it before anyone talks
              about a quote.
            </p>
          </div>
          <div class="flex flex-wrap gap-3">
            <a href="/#corpus-report" class="btn btn-primary">Request a corpus report</a>
            <a href="/#capabilities" class="btn btn-ghost">See capabilities</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>
