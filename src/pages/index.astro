---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import GameCard from '../components/GameCard.astro';

// ---------------------------------------------------------------------------
// Headline research stats. Sources are named in full in the Research section.
// ---------------------------------------------------------------------------
const heroStats = [
  { value: '4×', label: 'faster to train with immersive simulation', source: 'PwC, 2020' },
  { value: '75%', label: 'retained by learning-by-doing vs. ~5% from lecture', source: 'NTL' },
  { value: '275%', label: 'more confident to act after immersive practice', source: 'PwC, 2020' },
  { value: '9 in 10', label: 'employees more productive when learning is gamified', source: 'TalentLMS' },
];

// ---------------------------------------------------------------------------
// What we build — the three pillars of the practice.
// ---------------------------------------------------------------------------
const pillars = [
  {
    icon: '◎',
    title: 'Simulations that mirror the job',
    body:
      'Decision-driven environments where learners run the real scenario — a market, a patient, a plant floor — and feel the consequences. Skills form in context, so they transfer to the field.',
  },
  {
    icon: '⬡',
    title: 'Models of the scenarios that matter',
    body:
      'We recreate the procedures, operations, and edge cases staff have to get right — routine onboarding through high-pressure exceptions — so they can rehearse safely, as many times as it takes.',
  },
  {
    icon: '⟳',
    title: 'Measurable, research-backed design',
    body:
      'Built on retrieval practice, spaced repetition, and deliberate difficulty. We instrument outcomes so L&D teams can prove retention, confidence, and on-the-job impact.',
  },
];

// ---------------------------------------------------------------------------
// Portfolio, in two categories:
//   `titles`     — our own live games, playable now
//   `customSims` — simulations we design & build for a client's training need
// TO ADD A REAL GAME: drop an image in /public and set `image`, then fill in
// `href` (store/play link), `status: 'live'`, and the copy below.
// ---------------------------------------------------------------------------
const titles = [
  {
    title: 'Race to AGI',
    domain: 'Strategy · AI Safety',
    status: 'live',
    href: 'https://rtagi.online',
    blurb:
      'Run a frontier AI lab racing three rivals to build AGI. The twist: getting there first isn’t the win — getting there safely is. A browser strategy sim about long-term thinking under pressure.',
    outcome: 'Teaches risk, governance & trade-off reasoning',
    accent: 'from-accent/25 to-spark/20',
  },
  {
    title: 'CloudSims',
    domain: 'Management Sim · Cloud Ops',
    status: 'live',
    href: 'https://cloudsims.online',
    blurb:
      'Run a live cloud environment and juggle cost, latency, and availability under pressure. A terminal-styled management sim that teaches real infrastructure trade-offs — with an assessment mode for hiring and upskilling.',
    outcome: 'Builds cloud cost & reliability judgment',
    accent: 'from-spark/25 to-accent/20',
  },
];

const customSims = [
  {
    title: 'Field & Technical Ops',
    domain: 'Frontline · Onboarding',
    status: 'custom',
    href: '#contact',
    blurb:
      'Guided simulations for technical and field roles — equipment, workflows, and troubleshooting rehearsed before the first real shift. Cut time-to-competence for new hires.',
    outcome: 'Shortens time-to-competence on the floor',
    accent: 'from-spark/15 to-accent/20',
  },
  {
    title: 'Safety & Compliance Sim',
    domain: 'Corporate · High-risk operations',
    status: 'custom',
    href: '#contact',
    blurb:
      'Branching scenario training for safety-critical environments — hazard recognition, protocol under pressure, and the cost of shortcuts. Compliance that people remember, not click through.',
    outcome: 'Builds procedural recall & hazard judgment',
    accent: 'from-spark/20 to-accent/15',
  },
  {
    title: 'Leadership & Soft-Skills Lab',
    domain: 'Corporate · L&D',
    status: 'custom',
    href: '#contact',
    blurb:
      'Practice the hard conversations — feedback, conflict, change — with responsive characters and no real-world fallout. Confidence built through reps, not slideware.',
    outcome: 'Grows confidence & communication skill',
    accent: 'from-accent/20 to-spark/15',
  },
];

// ---------------------------------------------------------------------------
// Who it's for.
// ---------------------------------------------------------------------------
const audiences = [
  { title: 'Corporate L&D', body: 'Onboarding, compliance, and leadership programs that move the needle on retention and behavior — not just completion rates.' },
  { title: 'High-stakes & safety', body: 'Healthcare, energy, manufacturing, and aviation, where rehearsing failure in a sim is far cheaper than living it in the field.' },
  { title: 'Frontline & field teams', body: 'Technical, operational, and customer-facing roles that need judgment and muscle memory before day one.' },
  { title: 'Professional & continuing education', body: 'Programs for working professionals who are busy, skeptical of theory, and want skills that obviously apply to their work.' },
];

// ---------------------------------------------------------------------------
// Research findings — the evidence behind the approach.
// ---------------------------------------------------------------------------
const research = [
  {
    stat: '4× faster',
    finding:
      'In PwC’s controlled study, employees trained in immersive simulation learned up to four times faster than in the classroom, were 275% more confident applying what they learned, and were 4× more focused than e-learning peers.',
    source: 'PwC, “The Effectiveness of VR Soft Skills Training,” 2020',
  },
  {
    stat: 'd ≈ 0.36',
    finding:
      'A meta-analysis of serious games across dozens of studies found learners taught with games retained knowledge significantly better than those in conventional instruction — and learned more overall.',
    source: 'Wouters et al., Journal of Educational Psychology, 2013',
  },
  {
    stat: '75% vs 5%',
    finding:
      'Learners retain a far larger share of what they practice by doing than what they hear in a lecture — the core reason simulation-based training transfers to real performance.',
    source: 'NTL Institute, learning-by-doing research',
  },
  {
    stat: '89%',
    finding:
      'Nearly nine in ten employees report they’re more productive when learning is gamified, and 88% say it makes them happier at work — engagement that translates into completion and recall.',
    source: 'TalentLMS, Gamification at Work Survey',
  },
];

// ---------------------------------------------------------------------------
// Process.
// ---------------------------------------------------------------------------
const process = [
  { n: '01', title: 'Map the outcome', body: 'We start from the behavior you need to change and the metric that proves it — then work backward to the mechanics.' },
  { n: '02', title: 'Design the loop', body: 'A core interaction loop where every choice teaches, tuned with learning science: retrieval, spacing, and productive difficulty.' },
  { n: '03', title: 'Build & instrument', body: 'We ship a playable simulation wired with analytics, so progress and mastery are visible, not assumed.' },
  { n: '04', title: 'Measure & iterate', body: 'Retention, confidence, and transfer data feed the next iteration. Learning that improves with evidence.' },
];
---

<Base>
  <Nav />

  <main>
    <!-- ================= HERO ================= -->
    <section
      class="relative flex overflow-hidden sm:min-h-[calc(100svh-4rem)] sm:items-center"
    >
      <div class="absolute inset-0 grid-backdrop opacity-70"></div>
      <div
        class="pointer-events-none absolute -top-40 left-1/2 h-[520px] w-[820px] -translate-x-1/2 rounded-full opacity-60 blur-3xl"
        style="background: radial-gradient(closest-side, rgba(0,214,143,0.20), transparent 70%);"
      >
      </div>

      <div class="container-x relative w-full py-14 sm:py-16">
        <div class="mx-auto max-w-3xl text-center" data-reveal>
          <span
            class="inline-flex items-center gap-2 rounded-full border border-ink-700 bg-ink-800/60 px-4 py-1.5 font-mono text-xs text-ink-200"
          >
            <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
            Simulation &amp; modelling studio for training
          </span>

          <h1
            class="mt-6 font-display text-4xl font-bold leading-[1.05] tracking-tight text-paper sm:text-6xl lg:text-7xl"
          >
            Training that
            <span class="relative whitespace-nowrap">
              <span class="relative z-10 text-accent">sticks.</span>
              <span class="absolute inset-x-0 bottom-1 z-0 h-3 bg-accent/20"></span>
            </span>
            <br class="hidden sm:block" />
            Because they lived it.
          </h1>

          <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-ink-200">
            XAD Labs builds simulations that let your team rehearse the real work — critical
            procedures, live operations, day-one onboarding — until they can do it for real.
            Skills form in context, so they show up on the job, not just in the test.
          </p>

          <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
            <a href="#approach" class="btn btn-primary w-full sm:w-auto">See how it works</a>
            <a href="#contact" class="btn btn-ghost w-full sm:w-auto">Get in touch</a>
          </div>
        </div>

        <!-- Stat band -->
        <div
          class="mx-auto mt-10 grid max-w-5xl grid-cols-2 gap-px overflow-hidden rounded-2xl border border-ink-700/70 bg-ink-700/50 sm:mt-14 lg:grid-cols-4"
          data-reveal
          data-reveal-delay="120"
        >
          {
            heroStats.map((s) => (
              <div class="bg-ink-900/80 p-6 text-center sm:p-7">
                <div class="font-display text-3xl font-bold text-accent sm:text-4xl">{s.value}</div>
                <p class="mt-2 text-sm leading-snug text-ink-200">{s.label}</p>
                <p class="mt-2 font-mono text-[11px] uppercase tracking-wider text-ink-500">
                  {s.source}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ================= APPROACH ================= -->
    <section id="approach" class="border-t border-ink-800 bg-ink-900/40">
      <div class="container-x py-24 sm:py-28">
        <div class="max-w-2xl" data-reveal>
          <p class="eyebrow">The approach</p>
          <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-paper sm:text-4xl">
            People don’t remember what they’re told. They remember what they do.
          </h2>
          <p class="mt-4 text-lg leading-relaxed text-ink-200">
            People learn by acting, failing safely, and trying again. We design that loop
            deliberately — grounded in learning science, delivered as a working simulation.
          </p>
        </div>

        <div class="mt-14 grid gap-6 md:grid-cols-3">
          {
            pillars.map((p, i) => (
              <div class="card card-hover p-8" data-reveal data-reveal-delay={i * 100}>
                <div class="grid h-11 w-11 place-items-center rounded-xl bg-accent/10 text-2xl text-accent">
                  {p.icon}
                </div>
                <h3 class="mt-5 font-display text-xl font-semibold text-paper">{p.title}</h3>
                <p class="mt-3 text-[15px] leading-relaxed text-ink-300">{p.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ================= GAMES ================= -->
    <section id="games" class="border-t border-ink-800">
      <div class="container-x py-24 sm:py-28">
        <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end" data-reveal>
          <div class="max-w-2xl">
            <p class="eyebrow">The portfolio</p>
            <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-paper sm:text-4xl">
              Simulations built to train
            </h2>
            <p class="mt-4 text-lg leading-relaxed text-ink-200">
              From our own live titles to custom simulations we build for teams — each one designed
              around a specific learning outcome.
            </p>
          </div>
          <a href="#contact" class="hidden shrink-0 text-sm font-semibold text-accent-300 hover:text-accent sm:inline-flex"
            >Commission a custom sim →</a
          >
        </div>

        <!-- Category 1: our own live games -->
        <div class="mt-14 flex items-center gap-4" data-reveal>
          <h3 class="font-display text-xl font-semibold text-paper">Our games</h3>
          <span class="font-mono text-xs uppercase tracking-wider text-ink-500">Live &amp; playable</span>
          <span class="h-px flex-1 bg-ink-700/60"></span>
        </div>
        <div class="mt-6 grid gap-6 md:grid-cols-2">
          {titles.map((g, i) => <GameCard game={g} delay={(i % 2) * 100} />)}
        </div>

        <!-- Category 2: custom simulations built for clients -->
        <div class="mt-16 flex items-center gap-4" data-reveal>
          <h3 class="font-display text-xl font-semibold text-paper">Custom simulations</h3>
          <span class="font-mono text-xs uppercase tracking-wider text-ink-500">Built for your team</span>
          <span class="h-px flex-1 bg-ink-700/60"></span>
        </div>
        <div class="mt-6 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {customSims.map((g, i) => <GameCard game={g} delay={(i % 3) * 100} />)}
        </div>
      </div>
    </section>

    <!-- ================= AUDIENCES ================= -->
    <section class="border-t border-ink-800 bg-ink-900/40">
      <div class="container-x py-24 sm:py-28">
        <div class="max-w-2xl" data-reveal>
          <p class="eyebrow">Who it’s for</p>
          <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-paper sm:text-4xl">
            Built for the fields where getting it wrong is expensive
          </h2>
        </div>

        <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {
            audiences.map((a, i) => (
              <div class="rounded-2xl border border-ink-700/60 p-7" data-reveal data-reveal-delay={i * 80}>
                <h3 class="font-display text-lg font-semibold text-paper">{a.title}</h3>
                <p class="mt-3 text-[15px] leading-relaxed text-ink-300">{a.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ================= RESEARCH ================= -->
    <section id="research" class="border-t border-ink-800">
      <div class="container-x py-24 sm:py-28">
        <div class="grid gap-14 lg:grid-cols-[0.9fr_1.1fr] lg:gap-20">
          <div data-reveal>
            <p class="eyebrow">The evidence</p>
            <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-paper sm:text-4xl">
              Simulation isn’t a nice-to-have. It’s the most efficient way people learn to perform.
            </h2>
            <p class="mt-5 text-lg leading-relaxed text-ink-200">
              Decades of learning science point the same direction: active, experiential practice
              beats passive instruction on retention, confidence, and transfer to the real world.
              Here’s the research we build on.
            </p>
            <a href="#contact" class="btn btn-primary mt-8">Talk to us about outcomes</a>
          </div>

          <div class="space-y-5">
            {
              research.map((r, i) => (
                <div class="card p-7" data-reveal data-reveal-delay={i * 90}>
                  <div class="flex items-baseline gap-4">
                    <span class="shrink-0 font-display text-2xl font-bold text-accent">
                      {r.stat}
                    </span>
                    <p class="text-[15px] leading-relaxed text-ink-200">{r.finding}</p>
                  </div>
                  <p class="mt-4 border-t border-ink-700/60 pt-3 font-mono text-[11px] uppercase tracking-wider text-ink-500">
                    {r.source}
                  </p>
                </div>
              ))
            }
            <p class="pt-1 text-xs leading-relaxed text-ink-500">
              Figures reflect published third-party studies of simulation, VR, and game-based
              learning; exact results vary by program and context. We instrument every build so your
              own outcome data replaces industry averages.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= PROCESS ================= -->
    <section class="border-t border-ink-800 bg-ink-900/40">
      <div class="container-x py-24 sm:py-28">
        <div class="max-w-2xl" data-reveal>
          <p class="eyebrow">How we work</p>
          <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-paper sm:text-4xl">
            From learning goal to working simulation
          </h2>
        </div>

        <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {
            process.map((p, i) => (
              <div class="relative" data-reveal data-reveal-delay={i * 80}>
                <span class="font-mono text-sm font-medium text-accent-500">{p.n}</span>
                <h3 class="mt-3 font-display text-lg font-semibold text-paper">{p.title}</h3>
                <p class="mt-2 text-[15px] leading-relaxed text-ink-300">{p.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ================= ABOUT ================= -->
    <section id="about" class="border-t border-ink-800">
      <div class="container-x py-24 sm:py-28">
        <div class="grid gap-14 lg:grid-cols-[1fr_1fr] lg:gap-20 lg:items-center">
          <div data-reveal>
            <p class="eyebrow">About XAD Labs</p>
            <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-paper sm:text-4xl">
              A studio at the intersection of simulation, modelling, and learning science
            </h2>
            <div class="mt-5 space-y-4 text-lg leading-relaxed text-ink-200">
              <p>
                XAD Labs designs and builds simulations and models that train professionals,
                operators, and teams for the procedures, scenarios, and operations they can’t
                afford to get wrong.
              </p>
              <p>
                We pair simulation and game-design craft with evidence from cognitive and learning
                research, then measure the result. Our own titles, <a
                  href="https://rtagi.online"
                  target="_blank"
                  rel="noopener"
                  class="text-accent-300 underline decoration-accent/40 underline-offset-2 hover:decoration-accent"
                  >Race to AGI</a
                > and <a
                  href="https://cloudsims.online"
                  target="_blank"
                  rel="noopener"
                  class="text-accent-300 underline decoration-accent/40 underline-offset-2 hover:decoration-accent"
                  >CloudSims</a
                >, are proof of the philosophy: engaging on the surface, quietly teaching real
                decision-making underneath.
              </p>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-5" data-reveal data-reveal-delay="120">
            {
              [
                { k: 'Simulation-first', v: 'Learning by doing, not by slides' },
                { k: 'Evidence-led', v: 'Grounded in learning-science research' },
                { k: 'Outcome-measured', v: 'Analytics built into every build' },
                { k: 'Workforce-focused', v: 'Designed for professional learners' },
              ].map((c) => (
                <div class="rounded-2xl border border-ink-700/60 bg-ink-800/40 p-6">
                  <p class="font-display text-lg font-semibold text-accent-300">{c.k}</p>
                  <p class="mt-2 text-sm leading-relaxed text-ink-300">{c.v}</p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- ================= RESEARCH COLLABORATION ================= -->
    <section id="collaborate" class="border-t border-ink-800 bg-ink-900/40">
      <div class="container-x py-20 sm:py-24">
        <div
          class="flex flex-col gap-8 rounded-3xl border border-ink-700/70 bg-ink-800/40 p-8 sm:p-12 lg:flex-row lg:items-center lg:justify-between"
          data-reveal
        >
          <div class="max-w-2xl">
            <p class="eyebrow">Research collaboration</p>
            <h2 class="mt-3 font-display text-2xl font-bold tracking-tight text-paper sm:text-3xl">
              Open to working with universities &amp; research institutes
            </h2>
            <p class="mt-4 text-[15px] leading-relaxed text-ink-200 sm:text-base">
              We welcome collaborations with universities and esteemed research institutes on
              simulation and learning-science research projects — from study design to building the
              simulation itself. Where the partnering institution can cover the infrastructure
              costs, we’re glad to bring the studio’s design and engineering to the table.
            </p>
          </div>
          <a
            href="mailto:zameer@xadlabs.com?subject=Research%20collaboration%20%E2%80%94%20XAD%20Labs"
            class="btn btn-primary shrink-0"
          >
            Propose a project
          </a>
        </div>
      </div>
    </section>

    <!-- ================= CONTACT / CTA ================= -->
    <section id="contact" class="border-t border-ink-800">
      <div class="container-x py-24 sm:py-28">
        <div
          class="relative overflow-hidden rounded-3xl border border-ink-700/70 bg-ink-800/50 px-8 py-16 text-center sm:px-16 sm:py-20"
          data-reveal
        >
          <div class="absolute inset-0 grid-backdrop opacity-40"></div>
          <div
            class="pointer-events-none absolute -bottom-24 left-1/2 h-72 w-[640px] -translate-x-1/2 rounded-full opacity-70 blur-3xl"
            style="background: radial-gradient(closest-side, rgba(0,214,143,0.22), transparent 70%);"
          >
          </div>
          <div class="relative">
            <h2 class="font-display text-3xl font-bold tracking-tight text-paper sm:text-5xl">
              Bring simulation to your team
            </h2>
            <p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-ink-200">
              Tell us the procedure, role, or scenario your staff need to master. We’ll show you what
              simulation-based training can do for retention, confidence, and time-to-competence.
              No form — just email us and we’ll get back to you within one business day.
            </p>

            <a
              href="mailto:zameer@xadlabs.com?subject=Simulation%20enquiry%20%E2%80%94%20XAD%20Labs"
              class="mt-8 inline-flex items-center gap-3 rounded-2xl border border-ink-700/70 bg-ink-900/50 px-6 py-4 font-display text-xl font-semibold text-paper transition hover:border-accent/50 hover:text-accent-300 sm:text-2xl"
            >
              <span aria-hidden="true">✉</span>
              zameer@xadlabs.com
            </a>

            <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
              <a
                href="mailto:zameer@xadlabs.com?subject=Simulation%20enquiry%20%E2%80%94%20XAD%20Labs"
                class="btn btn-primary w-full sm:w-auto">Email us</a
              >
              <a
                href="https://rtagi.online"
                target="_blank"
                rel="noopener"
                class="btn btn-ghost w-full sm:w-auto">Try Race to AGI first ↗</a
              >
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>
