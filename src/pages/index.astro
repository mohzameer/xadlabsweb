---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';

const year = new Date().getFullYear();

// What we do, in three words each. Kept short so the page stays one screen.
const services = ['Generation at scale', 'Custom pipelines', 'Integration with your systems'];
---

<Base
  title="XAD Labs — PDF generation at scale"
  description="XAD Labs builds and operates the document infrastructure behind high-volume PDF generation — thousands of documents to several million. Makers of PodPDF. Colombo, Sri Lanka."
>
  <div class="relative flex min-h-screen flex-col overflow-hidden">
    <!-- Soft light-blue wash, top right. -->
    <div
      class="pointer-events-none absolute -right-40 -top-56 h-[760px] w-[760px] rounded-full opacity-70 blur-3xl"
      style="background: radial-gradient(closest-side, rgba(20,118,210,0.14), transparent 70%);"
    >
    </div>

    <header class="container-x relative shrink-0 pt-6 sm:pt-8">
      <Logo size="md" />
    </header>

    <main class="container-x relative flex flex-1 items-center py-6 sm:py-12">
      <div class="grid w-full items-center gap-8 sm:gap-12 lg:grid-cols-[1.15fr_0.85fr] lg:gap-20">
        <!-- Introduction -->
        <div>
          <p class="eyebrow">Document engineering · Colombo, Sri Lanka</p>

          <h1
            class="mt-4 font-serif text-[1.8rem] font-normal leading-[1.12] text-slate-900 sm:mt-5 sm:text-[2.6rem] lg:text-[3.2rem]"
          >
            PDF generation at scale, built to be relied on.
          </h1>

          <p class="mt-4 max-w-xl text-[15px] leading-relaxed text-slate-600 sm:mt-6 sm:text-lg">
            XAD Labs builds and operates the document infrastructure behind high-volume PDF
            generation — from thousands of documents to several million, on pipelines built to
            finish and account for every file.
          </p>

          <ul class="mt-5 hidden flex-wrap gap-2 sm:mt-7 sm:flex">
            {services.map((s) => <li class="chip">{s}</li>)}
          </ul>

          <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-3 text-sm sm:mt-9">
            <a href="mailto:zameer@xadlabs.com" class="btn btn-primary">Start a conversation</a>
            <a
              href="mailto:zameer@xadlabs.com"
              class="hidden font-medium text-slate-600 transition hover:text-brand-600 sm:inline"
              >zameer@xadlabs.com</a
            >
          </div>
        </div>

        <!-- Portfolio -->
        <div>
          <p class="eyebrow">Our platform</p>

          <a
            href="https://podpdf.com"
            target="_blank"
            rel="noopener"
            class="card card-hover mt-3 block p-5 sm:mt-4 sm:p-7"
          >
            <div class="flex items-baseline justify-between gap-4">
              <p class="font-display text-xl font-semibold text-slate-900">PodPDF</p>
              <span class="shrink-0 text-sm font-medium text-brand-600">podpdf.com ↗</span>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-slate-600 sm:text-[15px]">
              A REST API and web app for generating, converting, merging and editing PDFs — built,
              run and scaled by us.
            </p>
            <div class="mt-4 flex flex-wrap gap-2 border-t border-slate-200 pt-4 sm:mt-5 sm:pt-5">
              <span class="chip">REST API</span>
              <span class="chip">Templates</span>
              <span class="chip">Bulk jobs</span>
              <span class="chip">$0.01 / PDF</span>
            </div>
          </a>
        </div>
      </div>
    </main>

    <footer class="container-x relative shrink-0 border-t border-slate-200 py-5 sm:py-6">
      <div
        class="flex flex-col items-start justify-between gap-3 text-sm text-slate-500 sm:flex-row sm:items-center"
      >
        <a
          href="https://www.linkedin.com/in/zameermfm/"
          target="_blank"
          rel="noopener"
          class="font-medium transition hover:text-brand-600">LinkedIn ↗</a
        >
        <p class="font-mono text-xs">&copy; {year} XAD Labs</p>
      </div>
    </footer>
  </div>
</Base>
