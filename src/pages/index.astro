---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import GameCard from '../components/GameCard.astro';
import Icon from '../components/Icon.astro';

// ---------------------------------------------------------------------------
// The engagement — four fixed phases.
// ---------------------------------------------------------------------------
const phases = [
  {
    n: '1',
    name: 'Discovery',
    what:
      "We sit with the people who designed the process and the people who'll run it. We identify the specific decisions that carry risk.",
    dur: '1 week',
  },
  {
    n: '2',
    name: 'Build',
    what:
      'We model those decisions and calibrate against your own numbers — volumes, targets, staffing assumptions.',
    dur: '2–3 weeks',
  },
  {
    n: '3',
    name: 'Run',
    what:
      'Two cohorts go through it. Browser and mobile — no installs, no facilitator required on site.',
    dur: '1 week',
  },
  {
    n: '4',
    name: 'Report & revise',
    what:
      'We show you where understanding broke and where the design broke. One revision to the simulation.',
    dur: '1 week',
  },
];

const receive = [
  'A working simulation of your process, running on our infrastructure',
  'A model diagram your ops lead can read and correct — plain enough to argue with',
  'Group-level results: where divergence concentrates — by team, site, and shift',
  'A findings report separating “people didn’t understand X” from “X doesn’t work as designed”',
  'A record of every assumption we calibrated and who confirmed it',
];

// ---------------------------------------------------------------------------
// What makes a good Dry Run — the kinds of decisions worth rehearsing.
// ---------------------------------------------------------------------------
const dryRunFits = [
  { icon: 'file', text: 'A new client account with SLAs nobody has run against.' },
  { icon: 'swap', text: 'A staffing model that trades cost against coverage.' },
  { icon: 'alert', text: 'An escalation rule that sounds clear — until two things escalate at once.' },
];

// ---------------------------------------------------------------------------
// What you're actually buying — not the software, but these three.
// ---------------------------------------------------------------------------
const buying = [
  {
    icon: 'target',
    title: 'The reduction',
    body: 'Finding the one decision that carries the risk and cutting everything else away. The hard part — and what decides whether a simulation teaches anything. Model the whole process and you get a faithful replica that teaches nothing, because everything is in it.',
  },
  {
    icon: 'eye',
    title: 'An outside read',
    body: 'Someone who didn’t design the process, checking whether it holds up. Structurally hard to do in-house.',
  },
  {
    icon: 'calendar',
    title: 'A date',
    body: 'Five to six weeks, fixed scope, fixed price. Internal projects with no client waiting tend to ship at 70% and stall.',
  },
];

// ---------------------------------------------------------------------------
// Pricing — bracketed figures are placeholders to fill in.
// ---------------------------------------------------------------------------
const pricing = [
  { name: 'Dry Run', desc: 'As scoped above.', price: '[fixed fee]' },
  { name: 'Additional cohorts', desc: 'Beyond the first two.', price: '[per cohort]' },
  { name: 'Ongoing use for future intakes', desc: 'Optional — only if you want it.', price: '[annual]' },
];

// ---------------------------------------------------------------------------
// Starting — smallest useful first step, in order of preference.
// ---------------------------------------------------------------------------
const starting = [
  {
    lead: 'Send us the process document',
    body: ' — the design, the new rules, the deck. We’ll tell you within a week whether there’s a real simulation in it, and if there isn’t, we’ll tell you that too.',
  },
  {
    lead: 'Ninety minutes with the people who’ll run it.',
    body: ' We’ll run one of our existing simulations with them. If they don’t come out of it arguing about a decision they got wrong, there’s nothing here for you.',
  },
  {
    lead: 'Your last three incident or post-mortem reviews.',
    body: ' If the same failure appears twice, that’s the simulation — and you’ve already documented the model for us.',
  },
];

// ---------------------------------------------------------------------------
// Live work — real, playable proof.
// ---------------------------------------------------------------------------
const liveWork = [
  {
    title: 'Race to AGI',
    domain: 'Strategy · AI Safety',
    status: 'live',
    href: 'https://rtagi.cloudsims.online',
    blurb:
      'Run a frontier AI lab racing three rivals to build AGI. The twist: getting there first isn’t the win — getting there safely is. A browser strategy sim about long-term thinking under pressure.',
    outcome: 'Teaches risk, governance & trade-off reasoning',
    accent: 'from-accent/25 to-spark/20',
  },
  {
    title: 'CloudArchitect',
    domain: 'Management Sim · Cloud Architecture',
    status: 'live',
    href: 'https://cloudarch.cloudsims.online',
    blurb:
      'Run a live cloud environment and juggle cost, latency, and availability under pressure. A terminal-styled management sim that teaches real infrastructure trade-offs — with an assessment mode for hiring and upskilling.',
    outcome: 'Builds cloud cost & reliability judgment',
    accent: 'from-spark/25 to-accent/20',
  },
];

const mailto = 'mailto:zameer@xadlabs.com?subject=Dry%20Run%20%E2%80%94%20process%20document';
---

<Base>
  <Nav />

  <main>
    <!-- ================= HERO ================= -->
    <section class="relative overflow-hidden border-b border-ink-800">
      <div class="absolute inset-0 grid-backdrop opacity-60"></div>
      <div
        class="pointer-events-none absolute -top-40 left-1/2 h-[460px] w-[820px] -translate-x-1/2 rounded-full opacity-60 blur-3xl"
        style="background: radial-gradient(closest-side, rgba(0,214,143,0.16), transparent 70%);"
      >
      </div>

      <div class="container-x relative py-24 sm:py-32">
        <div class="mx-auto max-w-3xl" data-reveal>
          <span
            class="inline-flex items-center gap-2 rounded-full border border-ink-700 bg-ink-800/60 px-4 py-1.5 font-mono text-xs text-ink-200"
          >
            <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
            Dry Run · what actually landed
          </span>

          <h1
            class="mt-6 font-display text-4xl font-bold leading-[1.08] tracking-tight text-paper sm:text-5xl lg:text-6xl"
          >
            You rolled it out. Did it land?
          </h1>

          <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-200">
            Everyone was briefed. Completion is at 94%. But nobody knows whether your people are
            actually making the calls the new process intended — or where the gap is by team, site,
            or shift. A <strong class="font-semibold text-paper">Dry Run</strong> finds out.
          </p>

          <div class="mt-9 flex flex-col gap-3 sm:flex-row">
            <a href={mailto} class="btn btn-primary">Send us the process document</a>
            <a href="#what-we-do" class="btn btn-ghost">How it works</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= THE PROBLEM ================= -->
    <section id="problem" class="border-b border-ink-800">
      <div class="container-x py-20 sm:py-24">
        <div class="mx-auto max-w-3xl" data-reveal>
          <p class="eyebrow">The problem this addresses</p>
          <div class="mt-6 space-y-5 text-lg leading-relaxed text-ink-200">
            <p>
              You introduced the new model. Memos, town halls, a training session, sign-offs
              collected.
            </p>
            <p>
              Now someone has to say whether it worked. And the only evidence available is completion
              rates, a survey, and whatever the site managers are willing to report upward.
            </p>
            <p>
              None of that tells you whether a team lead facing two competing escalations at 11am on a
              Tuesday makes the call the new process intended.
            </p>
          </div>
          <blockquote
            class="mt-8 border-l-2 border-accent pl-6 font-display text-2xl font-semibold leading-snug text-paper"
          >
            Attendance isn’t adoption.
          </blockquote>
        </div>
      </div>
    </section>

    <!-- ================= WHAT WE DO ================= -->
    <section id="what-we-do" class="border-b border-ink-800 bg-ink-900/40">
      <div class="container-x py-20 sm:py-24">
        <div class="mx-auto max-w-3xl">
          <div data-reveal>
            <p class="eyebrow">What we do</p>
            <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-paper sm:text-4xl">
              A measurement, not a survey
            </h2>
            <div class="mt-6 space-y-5 text-lg leading-relaxed text-ink-200">
              <p>
                We build a simulation of your new process and put your people through it. Not a quiz
                on the memo — a working model of the decisions, where the tradeoffs are, what happens
                when two priorities collide at 11am on a Tuesday.
              </p>
              <p>
                Then we compare the calls they actually make against the ones the design intended, and
                show you where the two diverge.
              </p>
            </div>
          </div>

          <p class="mt-8 text-sm font-medium uppercase tracking-wider text-ink-400" data-reveal>
            You get two things out of it
          </p>
          <div class="mt-4 grid gap-5 sm:grid-cols-2" data-reveal data-reveal-delay="100">
            <div class="card p-7">
              <span class="font-mono text-sm text-accent-500">01</span>
              <p class="mt-3 text-[15px] leading-relaxed text-ink-200">
                <strong class="font-semibold text-paper">You find out what actually landed.</strong>
                Not who attended. Which decisions are being made the way the design intended, and
                where the divergence is concentrated.
              </p>
            </div>
            <div class="card p-7">
              <span class="font-mono text-sm text-accent-500">02</span>
              <p class="mt-3 text-[15px] leading-relaxed text-ink-200">
                <strong class="font-semibold text-paper">You find out where the design is at
                  fault.</strong> Some gaps aren’t comprehension. A rule that reads clearly and
                collapses under two simultaneous escalations is a design defect, not a training
                failure. The report separates them.
              </p>
            </div>
          </div>

          <p class="mt-8 text-lg leading-relaxed text-ink-100" data-reveal>
            The second one is the part nobody else offers.
            <span class="text-accent-300"
              >Completion rates tell you people attended. Running the decisions tells you which ones
              your design gets wrong.</span
            >
          </p>
        </div>
      </div>
    </section>

    <!-- ================= GROUP-LEVEL, NOT INDIVIDUAL ================= -->
    <section id="reporting" class="border-b border-ink-800">
      <div class="container-x py-20 sm:py-24">
        <div class="mx-auto max-w-3xl">
          <div
            class="rounded-3xl border border-accent/25 bg-ink-800/40 p-8 sm:p-12"
            data-reveal
          >
            <div class="flex items-center gap-4">
              <div class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-accent/10 text-accent">
                <Icon name="users" class="h-6 w-6" />
              </div>
              <div>
                <p class="eyebrow">Non-negotiable</p>
                <h2 class="mt-1 font-display text-2xl font-bold tracking-tight text-paper sm:text-3xl">
                  Group-level, not individual
                </h2>
              </div>
            </div>
            <div class="mt-6 space-y-4 text-lg leading-relaxed text-ink-200">
              <p>
                Leadership sees the pattern — which sites, which shifts, which decisions. Individuals
                see their own results and nobody else’s.
              </p>
              <p>
                This isn’t diplomacy. If people believe they’re being personally graded, they play to
                look correct instead of deciding naturally, and the data stops being worth having.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= THE ENGAGEMENT ================= -->
    <section id="engagement" class="border-b border-ink-800">
      <div class="container-x py-20 sm:py-24">
        <div class="mx-auto max-w-3xl">
          <div data-reveal>
            <p class="eyebrow">The engagement</p>
            <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-paper sm:text-4xl">
              Fixed scope. Fixed price. Finite.
            </h2>
            <p class="mt-4 text-lg leading-relaxed text-ink-200">
              Every Dry Run runs the same shape.
            </p>
          </div>

          <!-- Phase table -->
          <div class="mt-8 border-y border-ink-800" data-reveal>
            {
              phases.map((p) => (
                <div class="grid gap-2 border-t border-ink-800 py-6 first:border-t-0 sm:grid-cols-[13rem_1fr_auto] sm:items-baseline sm:gap-8">
                  <div class="flex items-baseline gap-3">
                    <span class="font-mono text-sm text-accent-500">{p.n}</span>
                    <span class="font-display text-lg font-semibold text-paper">{p.name}</span>
                  </div>
                  <p class="text-[15px] leading-relaxed text-ink-300">{p.what}</p>
                  <span class="whitespace-nowrap font-mono text-xs uppercase tracking-wider text-ink-400 sm:text-right">
                    {p.dur}
                  </span>
                </div>
              ))
            }
          </div>

          <p class="mt-6 text-lg text-ink-100" data-reveal>
            <strong class="font-semibold text-paper">Total: 5–6 weeks.</strong> Then we hand over the
            results and go.
          </p>

          <!-- Receive / don't receive -->
          <div class="mt-12 grid gap-8 lg:grid-cols-2" data-reveal>
            <div>
              <h3 class="font-display text-lg font-semibold text-paper">What you receive</h3>
              <ul class="mt-5 space-y-3">
                {
                  receive.map((item) => (
                    <li class="flex gap-3 text-[15px] leading-relaxed text-ink-200">
                      <span class="mt-0.5 text-accent" aria-hidden="true">
                        ✓
                      </span>
                      <span set:html={item} />
                    </li>
                  ))
                }
              </ul>
            </div>
            <div>
              <h3 class="font-display text-lg font-semibold text-paper">What you don’t receive</h3>
              <p class="mt-5 text-[15px] leading-relaxed text-ink-300">
                No system to maintain. No licence to renew. No integration into your stack. If you
                want the simulation kept alive for future cohorts, that is a separate conversation you
                can have later, or not at all.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= WHAT MAKES A GOOD DRY RUN ================= -->
    <section id="fit" class="border-b border-ink-800 bg-ink-900/40">
      <div class="container-x py-20 sm:py-24">
        <div class="mx-auto max-w-3xl">
          <div data-reveal>
            <p class="eyebrow">What makes a good Dry Run</p>
            <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-paper sm:text-4xl">
              A decision worth arguing about
            </h2>
            <p class="mt-4 text-lg leading-relaxed text-ink-200">
              The strongest candidates share one thing: a decision where two experienced people at
              your company would disagree.
            </p>
          </div>

          <div class="mt-8 grid gap-4 sm:grid-cols-3">
            {
              dryRunFits.map((f, i) => (
                <div class="card card-hover group p-6" data-reveal data-reveal-delay={i * 100}>
                  <div class="grid h-10 w-10 place-items-center rounded-xl bg-accent/10 text-accent transition duration-300 group-hover:scale-110">
                    <Icon name={f.icon} />
                  </div>
                  <p class="mt-4 text-[15px] leading-relaxed text-ink-200">{f.text}</p>
                </div>
              ))
            }
          </div>
          <p class="mt-4 text-sm leading-relaxed text-ink-400" data-reveal>
            Anywhere the new process asks someone to choose, and choosing wrong is expensive.
          </p>

          <blockquote
            class="mt-8 border-l-2 border-accent pl-6 text-lg leading-relaxed text-ink-100"
            data-reveal
          >
            That’s the test we apply before we quote: <em class="text-paper"
              >can two competent people here disagree about the right call, and would running it
              settle the argument?</em
            >
          </blockquote>

          <p class="mt-6 text-[15px] leading-relaxed text-ink-400" data-reveal>
            If the answer is no — if there’s one right way and people just need to learn it — we’ll
            say so, and point you somewhere cheaper. That conversation takes a week and costs nothing.
          </p>
        </div>
      </div>
    </section>

    <!-- ================= WHAT YOU'RE ACTUALLY BUYING ================= -->
    <section id="buying" class="border-b border-ink-800">
      <div class="container-x py-20 sm:py-24">
        <div class="mx-auto max-w-3xl">
          <div data-reveal>
            <p class="eyebrow">What you’re actually buying</p>
            <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-paper sm:text-4xl">
              Not the software
            </h2>
            <p class="mt-4 text-lg leading-relaxed text-ink-200">
              That part gets easier every month. Three things instead.
            </p>
          </div>

          <div class="mt-8 space-y-4">
            {
              buying.map((b, i) => (
                <div
                  class="card card-hover group flex gap-5 p-6 sm:p-7"
                  data-reveal
                  data-reveal-delay={i * 100}
                >
                  <div class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-accent/10 text-accent transition duration-300 group-hover:scale-110">
                    <Icon name={b.icon} class="h-6 w-6" />
                  </div>
                  <div>
                    <h3 class="font-display text-lg font-semibold text-paper">{b.title}</h3>
                    <p class="mt-2 text-[15px] leading-relaxed text-ink-300">{b.body}</p>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- ================= PRICING ================= -->
    <section id="pricing" class="border-b border-ink-800 bg-ink-900/40">
      <div class="container-x py-20 sm:py-24">
        <div class="mx-auto max-w-3xl">
          <div data-reveal>
            <p class="eyebrow">Pricing</p>
            <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-paper sm:text-4xl">
              Priced per engagement, not per seat, not per year
            </h2>
          </div>

          <div class="mt-8 border-y border-ink-800" data-reveal>
            {
              pricing.map((p) => (
                <div class="flex flex-col gap-1 border-t border-ink-800 py-5 first:border-t-0 sm:flex-row sm:items-baseline sm:justify-between sm:gap-8">
                  <div>
                    <p class="font-display text-lg font-semibold text-paper">{p.name}</p>
                    <p class="text-sm text-ink-400">{p.desc}</p>
                  </div>
                  <span class="whitespace-nowrap font-mono text-sm text-accent-300">{p.price}</span>
                </div>
              ))
            }
          </div>

          <p class="mt-5 text-[15px] leading-relaxed text-ink-200" data-reveal>
            No per-participant licensing. Run it with fifteen people or eighty; the price is the same.
          </p>
          <p class="mt-2 text-xs leading-relaxed text-ink-500" data-reveal>
            Bracketed figures are placeholders — final pricing is quoted per engagement.
          </p>
        </div>
      </div>
    </section>

    <!-- ================= STARTING ================= -->
    <section id="start" class="border-b border-ink-800">
      <div class="container-x py-20 sm:py-24">
        <div class="mx-auto max-w-3xl">
          <div data-reveal>
            <p class="eyebrow">Starting</p>
            <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-paper sm:text-4xl">
              The smallest useful first step
            </h2>
            <p class="mt-4 text-lg leading-relaxed text-ink-200">In order of preference:</p>
          </div>

          <ol class="mt-8 space-y-6" data-reveal>
            {
              starting.map((s, i) => (
                <li class="flex gap-4">
                  <span class="font-display text-xl font-bold text-accent-500">{i + 1}</span>
                  <p class="text-lg leading-relaxed text-ink-200">
                    <strong class="font-semibold text-paper">{s.lead}</strong>
                    {s.body}
                  </p>
                </li>
              ))
            }
          </ol>

          <div class="mt-10 flex flex-col gap-3 sm:flex-row" data-reveal>
            <a href={mailto} class="btn btn-primary">Send the process document</a>
            <a href="mailto:zameer@xadlabs.com" class="btn btn-ghost">zameer@xadlabs.com</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= LIVE WORK ================= -->
    <section id="work" class="border-b border-ink-800 bg-ink-900/40">
      <div class="container-x py-20 sm:py-24">
        <div class="mx-auto max-w-3xl">
          <div class="flex items-end justify-between gap-4" data-reveal>
            <div>
              <p class="eyebrow">Live work</p>
              <h2 class="mt-3 font-display text-2xl font-bold tracking-tight text-paper sm:text-3xl">
                Simulations you can play right now
              </h2>
            </div>
            <a
              href="https://cloudsims.online"
              target="_blank"
              rel="noopener"
              class="hidden shrink-0 whitespace-nowrap text-sm font-semibold text-accent-300 transition hover:text-accent sm:inline-flex"
              >Games catalogue ↗</a
            >
          </div>

          <div class="mt-8 grid gap-6 sm:grid-cols-2">
            {liveWork.map((g, i) => <GameCard game={g} delay={(i % 2) * 100} />)}
          </div>
        </div>
      </div>
    </section>

    <!-- ================= CONTACT ================= -->
    <section id="contact">
      <div class="container-x py-20 sm:py-24">
        <div class="mx-auto max-w-3xl text-center" data-reveal>
          <p class="font-display text-xl font-bold text-paper">
            <span class="text-accent">xad</span> labs
          </p>
          <p class="mt-2 font-mono text-xs uppercase tracking-[0.2em] text-ink-400">
            Simulation &amp; modelling studio
          </p>
          <a
            href={mailto}
            class="mt-6 inline-flex items-center gap-3 rounded-2xl border border-ink-700/70 bg-ink-900/50 px-6 py-4 font-display text-xl font-semibold text-paper transition hover:border-accent/50 hover:text-accent-300 sm:text-2xl"
          >
            <span aria-hidden="true">✉</span>
            zameer@xadlabs.com
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>
